# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# WalletConnect (for wallet connections)
# Get from: https://cloud.walletconnect.com → Create Project → Copy Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Stripe (for subscriptions - Phase 3)
# STRIPE_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (for email reports)
# RESEND_API_KEY=re_xxx

# Telegram Bot (for alerts)
# TELEGRAM_BOT_TOKEN=xxx

# Optional: Analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

# Rendite MCP server (agent-facing yield tools) — see src/mcp/README.md
# Reuses the Supabase vars above. Optional per-chain RPC overrides used by
# read_stablecoin_positions (falls back to viem public RPCs if unset):
# RPC_URL_1=https://...       # Ethereum mainnet
# RPC_URL_10=https://...      # Optimism
# RPC_URL_137=https://...     # Polygon
# RPC_URL_42161=https://...   # Arbitrum
# RPC_URL_8453=https://...    # Base

# ── x402 paid agent API (/api/agent/*) ───────────────────────────────────────
# The paywall is OFF until X402_PAY_TO is set (free tools stay open regardless).
#
# ⚠️  X402_PAY_TO IS A PUBLIC RECEIVING ADDRESS ONLY. Paste your wallet's public
#     0x address here (a cold-wallet receive address is fine). NEVER put a private
#     key or seed phrase anywhere in this app — receiving payments needs only the
#     address, and the cold wallet stays offline.
# X402_PAY_TO=0xYourPublicReceivingAddress
#
# Network: base-sepolia (testnet, default — test with zero real money) or base (mainnet).
# X402_NETWORK=base-sepolia
#
# Facilitator: leave unset for the default testnet facilitator (x402.org).
# For base MAINNET settlement, use the Coinbase CDP facilitator (needs CDP keys).
# X402_FACILITATOR_URL=https://x402.org/facilitator
